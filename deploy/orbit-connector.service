[Unit]
Description=Orbit Control Plane connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kyle
EnvironmentFile=-/etc/orbit-control-plane/connector.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/orbit-control-plane/connector/orbit-connector.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
