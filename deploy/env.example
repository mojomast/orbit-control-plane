# Copy to /etc/orbit-control-plane/env and chmod 0640.
# Do not commit a filled-in copy.

ORBIT_CP_BIND=
ORBIT_CP_PORT=8787
ORBIT_CP_DATA=/var/lib/orbit-control-plane
ORBIT_CP_TOKEN_DIR=/etc/orbit-control-plane/tokens
